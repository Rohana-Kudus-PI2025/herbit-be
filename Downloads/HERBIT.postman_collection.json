				{
					"name": "login user",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// ===== Save user_token & auto-switch role =====",
									"let token;",
									"const cookieHeader = pm.response.headers.get(\"Set-Cookie\");",
									"",
									"if (cookieHeader) {",
									"  const cookieName = pm.collectionVariables.get(\"cookie_name\") || \"access_token\";",
									"  const m = cookieHeader.match(new RegExp(`${cookieName}=([^;]+)`));",
									"  if (m) token = m[1];",
									"}",
									"",
									"// Fallback jika token juga ada di JSON body",
									"try {",
									"  const json = pm.response.json();",
									"  if (!token && (json?.token || json?.data?.token)) {",
									"    token = json.token || json.data.token;",
									"  }",
									"} catch (e) {}",
									"",
									"if (token) {",
									"  pm.collectionVariables.set(\"user_token\", token);",
									"  pm.collectionVariables.set(\"auth_role\", \"user\"); // AUTO switch ke user",
									"  console.log(\"✅ user_token saved & role switched to user\");",
									"} else {",
									"  console.warn(\"⚠️ Token not found in response for user login\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
