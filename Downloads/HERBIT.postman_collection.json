				{
					"name": "login admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// ===== Save admin_token & auto-switch role =====",
									"let token;",
									"const cookieHeader = pm.response.headers.get(\"Set-Cookie\");",
									"",
									"if (cookieHeader) {",
									"  const cookieName = pm.collectionVariables.get(\"cookie_name\") || \"access_token\";",
									"  const m = cookieHeader.match(new RegExp(`${cookieName}=([^;]+)`));",
									"  if (m) token = m[1];",
									"}",
									"",
									"// Fallback jika token ada di JSON",
									"try {",
									"  const json = pm.response.json();",
									"  if (!token && (json?.token || json?.data?.token)) {",
									"    token = json.token || json.data.token;",
									"  }",
									"} catch (e) {}",
									"",
									"if (token) {",
									"  pm.collectionVariables.set(\"admin_token\", token);",
									"  pm.collectionVariables.set(\"auth_role\", \"admin\"); // AUTO switch ke admin",
									"  console.log(\"✅ admin_token saved & role switched to admin\");",
									"} else {",
									"  console.warn(\"⚠️ Admin token not found in response\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
