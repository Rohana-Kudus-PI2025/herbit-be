					"",
					"  const userToken  = pm.collectionVariables.get(\"user_token\");",
					"  const adminToken = pm.collectionVariables.get(\"admin_token\");",
					"  const token = role === \"admin\" ? adminToken : userToken;",
					"",
					"  // Bypass per-request bila perlu: set local var \"noAuthCookie\" = true",
					"  const noAuthCookie = pm.variables.get(\"noAuthCookie\");",
					"",
					"  // Bersihkan header Cookie agar tidak dobel",
					"  pm.request.headers.remove(\"Cookie\");",
					"",
					"  if (!noAuthCookie && token) {",
					"    pm.request.headers.add({",
					"      key: \"Cookie\",",
					"      value: `${cookieName}=${token}`",
					"    });",
					"    console.log(`🍪 Injected Cookie for role: ${role}`);",
					"  } else {",
					"    console.warn(\"⚠️ Cookie not injected (missing token or bypassed).\");",
					"  }",
					"})();"
				]
			}
